# ── ฐานข้อมูล SQL Server (Prisma) ────────────────────────────────
# รูปแบบ: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=finishing;user=sa;password=YourStrongPassword123!;encrypt=true;trustServerCertificate=true"

# ── ระบบยืนยันตัวตนเดิม (Laravel Sanctum) ─────────────────────────
# ถ้าเว้นว่างไว้ ระบบจะเข้าโหมดทดสอบเฉพาะตอน `npm run dev`
SANCTUM_API_URL=

